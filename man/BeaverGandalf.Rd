\subsection{Method \code{gandalf_process_discovery()}}{
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{BeaverGandalf$gandalf_process_discovery()}\if{html}{\out{</div>}}
}

\subsection{Details}{
\itemize{
\item The method scans the log directory (\code{self$SID_log}) for files with the pattern
\verb{*_success.txt} to identify completed steps.
\item It calculates the number of completed steps and determines the ongoing step.
\item For RNAseq mode, the workflow is limited to two steps, and the method returns
\code{2} if the second step is ongoing.
\item For other modes, the workflow can have up to three steps, and the method returns
the current step number (1, 2, or 3).
\item The method logs the current progress using the \code{message} function.
}
}

\subsection{Returns}{
An integer indicating the current step number of the workflow.
}
}
