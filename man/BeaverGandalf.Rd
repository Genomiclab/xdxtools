\subsection{Method \code{gandalf2wars()}}{
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{BeaverGandalf$gandalf2wars(
  jobflow = "workflows",
  enigent = beaver_engine_detect(),
  snakemake_condaenv = "",
  dry_run = F,
  partition = "amd_512",
  use_sbatch = F,
  cpus = c("20", "40", "10"),
  mem = c("100G", "400G", "400G"),
  dwarf_workers = 1
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{jobflow}}{\code{character} The directory containing the Snakemake workflow files (default: "workflows").}

\item{\code{enigent}}{\code{character} The execution environment detected by \code{beaver_engine_detect()} (default: result of \code{beaver_engine_detect()}).}

\item{\code{snakemake_condaenv}}{\code{character} The name of the Conda environment to use for Snakemake (default: "").}

\item{\code{dry_run}}{\code{logical} Whether to perform a dry run without executing the workflow (default: FALSE).}

\item{\code{partition}}{the partition of resources used by slrum cluster,only works in slrum mode}

\item{\code{use_sbatch}}{\code{logical} Whether to use sbatch to submit a job or use srun in FALSE}

\item{\code{cpus}}{the cpu cores used in the 3 steps, default as 20,40,10}

\item{\code{mem}}{the mem used in the 3 steps,default as "100G","400G","400G"}

\item{\code{dwarf_workers}}{the Parallel number in Step 2 and Step 3,default as 1.}
}
\if{html}{\out{</div>}}
}
\subsection{Details}{
\itemize{
\item The method detects the execution environment using \code{beaver_engine_detect()}.
\item It configures the workflow based on the environment (Kubernetes, Slurm, or container).
\item The method runs the workflow in steps, with each step potentially involving multiple samples.
\item Logs for each step are recorded in the \code{run_log} field.
\item The method supports different modes (e.g., RRBS, BSSEQ, RNASEQ) and PDX pipelines.
}

Download or Aggregate Workflow Results

This method aggregates the results from the workflow execution and prepares
them for download or further analysis. It supports multiple result types and
compression methods.
}

\subsection{Returns}{
\code{NULL} (executes the workflow and logs the process).
}
}
