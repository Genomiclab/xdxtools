#configfile: "config/config.yaml"

SIDs = config["SIDs"]
species = config["species"]
chrs = config["chrs"]
# 运行所有流程时，rule all 需要加入所有的output汇总
rule all:
  input:
    expand(os.path.join(config["qcDir_before"], "{sample}_R1_fastqc.zip"), sample=SIDs),
    expand(os.path.join(config["qcDir_before"], "{sample}_R2_fastqc.zip"), sample=SIDs),
    expand(os.path.join(config["qcDir_before"], "{sample}_R1_fastqc.html"), sample=SIDs),
    expand(os.path.join(config["qcDir_before"], "{sample}_R2_fastqc.html"), sample=SIDs),
    expand(os.path.join(config["trimDir"], "{sample}_val_1.fq.gz"),sample = SIDs),
    expand(os.path.join(config["trimDir"], "{sample}_val_2.fq.gz"),sample = SIDs),
    expand(os.path.join(config["trimDir"], "{sample}_R1.fastq.gz_trimming_report.txt"),sample = SIDs),
    expand(os.path.join(config["trimDir"], "{sample}_R2.fastq.gz_trimming_report.txt"),sample = SIDs),
    expand(os.path.join(config["qcDir_after"], "{sample}_val_1_fastqc.zip"), sample=SIDs),
    expand(os.path.join(config["qcDir_after"], "{sample}_val_2_fastqc.zip"), sample=SIDs),
    expand(os.path.join(config["qcDir_after"], "{sample}_val_1_fastqc.html"), sample=SIDs),
    expand(os.path.join(config["qcDir_after"], "{sample}_val_2_fastqc.html"), sample=SIDs),
    expand(os.path.join(config["qcDir"], "{sample}_seqkit_stat.txt"), sample=SIDs) ,
    os.path.join(config["SID_log"], "step1_success.txt"),
    expand(os.path.join(config["bsmapDir"], "{sample}_{species}.bam"), sample=SIDs,species = species) ,
    expand(os.path.join(config["outdir_qualimap"],"{sample}_{species}","qualimapReport.html") , sample=SIDs,species = species),
    expand(os.path.join(config["qcDir"],"GCbias","{sample}_{species}", "gc_bias_metrics.txt"),sample=SIDs,species = species),
    expand(os.path.join(config["qcDir"],"GCbias","{sample}_{species}", "gc_bias_metrics.pdf"),sample=SIDs,species = species),
    expand(os.path.join(config["qcDir"],"GCbias","{sample}_{species}", "summary_metrics.txt"),sample=SIDs,species = species),
    expand(os.path.join(config["bsmapDir"], "{sample}_pdx_patch_success"),sample=SIDs),
    expand(os.path.join(config["bsmapDir"],"Filtered_bams" ,"{sample}_fixed_"+config["graft"]+"_Filtered.bam"),sample=SIDs),
    os.path.join(config["qc_summary"], "multiqc_report.html"),
    os.path.join(config["SID_log"], "step2_success.txt"),
    expand(os.path.join(config["outDir_mCall"], "{sample}_nsort.bismark.cov.gz"),sample = SIDs),
    expand(os.path.join(config["bsmapDir"], "{sample}_nsort.bam"),sample =SIDs ),
    os.path.join(config["outDir_mCall"], "methrixh5","assays.h5"),
    os.path.join(config["outDir_mCall"], "methrixh5","se.rds"),
    os.path.join(config["outDir_mCall"], "methrixh5","bsseq.RDS"),
    os.path.join(config["bsmapDir"], "bismark_summary_report.html"),
    os.path.join(config["qc_summary"],"qc_summary.txt"),
    os.path.join(config["SID_log"], "step3_success.txt")
    

# 第一次QC
include: "rules/01fastqcAtfirst.smk"

# Trim
include: "rules/02fastq2trim.smk"

# 第二次QC
include: "rules/03-0-fastqcAtclean.smk"

#seqkit
include: "rules/03-1-seqkit.smk"

# step checker

include: "rules/rnaseq_step1_checker.smk"

# bsmap2sort

include: "rules/04bsmap2sort_bismark.smk"

# patch 4 PDX

include:"rules/picard_pdx_patch.smk"

# qualimap

include:"rules/05-3-qualimap.smk"

#Xenofilter

include:"rules/XenofilteR.smk"

# GCbias

include:"rules/collectGCbias.smk"

# multiqc

include:"rules/multiqc.smk"

# step checker

include: "rules/BSseq_step2_checker.smk"

# build beta

include:"rules/pdx_build_methy_matrix_bismark.smk"

# bismark report

include:"rules/bismark_report2summary.smk"

# qc summary

include:"rules/bs_qc_summary.smk"

# step checker

include: "rules/BSseq_step3_checker.smk"

# methrix

include:"rules/methrix_object.smk"




