#configfile: "config/config.yaml"

SIDs = config["SIDs"]
species = config["species"]
chrs = config["chrs"]
# 运行所有流程时，rule all 需要加入所有的output汇总
rule all:
  input:
    expand(os.path.join(config["bsmapDir"],"Filtered_bams" ,"{sample}_"+"{species}"+"_Filtered.bam"), sample=SIDs,species = species) ,
    expand(os.path.join(config["outDir_mCall"], "{sample}_{species}"+".txt"), sample=SIDs,species = species)

# build matrix

include:"rules/rnaseq_htseq_xen.smk"

